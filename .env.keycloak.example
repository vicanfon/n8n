# n8n Keycloak Configuration Example
# Copy this file to .env and update the values

# ===== Keycloak OIDC Configuration =====

# Enable OIDC login
N8N_SSO_OIDC_LOGIN_ENABLED=true

# Keycloak client ID (as configured in Keycloak)
N8N_SSO_OIDC_CLIENT_ID=n8n-client

# Keycloak client secret (leave empty for public clients like dash-button)
N8N_SSO_OIDC_CLIENT_SECRET=

# Keycloak issuer URL (realm URL)
N8N_SSO_OIDC_ISSUER=http://localhost:8080/realms/n8n-realm

# Keycloak authorization endpoint
N8N_SSO_OIDC_AUTHORIZATION_URL=http://localhost:8080/realms/n8n-realm/protocol/openid-connect/auth

# Keycloak token endpoint
N8N_SSO_OIDC_TOKEN_URL=http://localhost:8080/realms/n8n-realm/protocol/openid-connect/token

# Keycloak userinfo endpoint
N8N_SSO_OIDC_USERINFO_URL=http://localhost:8080/realms/n8n-realm/protocol/openid-connect/userinfo

# OpenID Connect discovery endpoint (alternative to specifying individual endpoints)
N8N_SSO_OIDC_DISCOVERY_ENDPOINT=http://localhost:8080/realms/n8n-realm/.well-known/openid-configuration

# Just-in-time user provisioning (create users automatically on first login)
N8N_SSO_JUST_IN_TIME_PROVISIONING=true

# Redirect URL (must match the one configured in Keycloak)
N8N_SSO_REDIRECT_URL=http://localhost:5678/rest/sso/oidc/callback

# ===== Frontend Keycloak Configuration =====
# These are used by the dash-button component

# Keycloak base URI
VITE_KEYCLOAK_URI=http://localhost:8080

# Keycloak realm name
VITE_KEYCLOAK_REALM=n8n-realm

# Keycloak client ID (should match N8N_SSO_OIDC_CLIENT_ID)
VITE_KEYCLOAK_CLIENT_ID=n8n-client

# ===== n8n General Configuration =====

# n8n instance URL
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Database configuration (optional - defaults to SQLite)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=n8n
