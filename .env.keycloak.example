# n8n Keycloak Configuration Example (Community Edition Compatible)
# Copy this file to .env and update the values

# ===== Keycloak Configuration =====
# These settings work with n8n Community Edition (no enterprise license required)

# Enable Keycloak authentication
N8N_KEYCLOAK_ENABLED=true

# Keycloak base URI
N8N_KEYCLOAK_URI=http://localhost:8080

# Keycloak realm name
N8N_KEYCLOAK_REALM=n8n-realm

# Keycloak client ID (as configured in Keycloak)
N8N_KEYCLOAK_CLIENT_ID=n8n-client

# ===== Frontend Keycloak Configuration =====
# These are used by the dash-button component

# Keycloak base URI
VITE_KEYCLOAK_URI=http://localhost:8080

# Keycloak realm name
VITE_KEYCLOAK_REALM=n8n-realm

# Keycloak client ID (should match N8N_SSO_OIDC_CLIENT_ID)
VITE_KEYCLOAK_CLIENT_ID=n8n-client

# ===== n8n General Configuration =====

# n8n instance URL
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http

# Database configuration (optional - defaults to SQLite)
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD=n8n
