# Multi-stage build for n8n with DS2 branding
# Stage 1: Build the application
FROM node:22.21.0-alpine AS builder

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages ./packages
COPY patches ./patches

# Install dependencies
RUN pnpm install --frozen-lockfile

# Build the application
RUN pnpm build

# Stage 2: Create production image
FROM node:22.21.0-alpine AS runtime

# Install dependencies for n8n runtime
RUN apk add --no-cache \
    su-exec \
    tini \
    tzdata \
    ca-certificates \
    python3 \
    py3-pip \
    build-base \
    git

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Create n8n user
RUN addgroup -g 1000 n8n && \
    adduser -D -u 1000 -G n8n n8n

# Set working directory
WORKDIR /home/n8n

# Copy built application from builder
COPY --from=builder --chown=n8n:n8n /app /home/n8n

# Set environment variables
ENV NODE_ENV=production \
    N8N_USER_FOLDER=/home/n8n/.n8n \
    N8N_PORT=5678 \
    N8N_PROTOCOL=http \
    N8N_HOST=0.0.0.0

# Expose port
EXPOSE 5678

# Create data directory
RUN mkdir -p /home/n8n/.n8n && chown -R n8n:n8n /home/n8n

# Switch to n8n user
USER n8n

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:5678/healthz || exit 1

# Start n8n
ENTRYPOINT ["tini", "--"]
CMD ["pnpm", "--filter=n8n", "start"]
